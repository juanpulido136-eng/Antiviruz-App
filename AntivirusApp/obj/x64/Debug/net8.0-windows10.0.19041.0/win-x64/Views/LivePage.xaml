<Page x:ConnectionId='1'
    x:Class="AntivirusApp.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AntivirusApp.Views"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="ResultRow"                            >
            <Grid x:ConnectionId='3' Padding="16,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                    <FontIcon x:ConnectionId='11'                            FontSize="14" Foreground="{StaticResource MutedBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:ConnectionId='9'                      FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:ConnectionId='10'                        FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon x:ConnectionId='7'                               FontSize="13"                              />
                    <TextBlock x:ConnectionId='8'                              FontSize="13" FontWeight="SemiBold"                              />
                </StackPanel>

                <TextBlock x:ConnectionId='4' Grid.Column="3"                          VerticalAlignment="Center" FontWeight="SemiBold"                              />
                <TextBlock x:ConnectionId='5' Grid.Column="4"                          VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:ConnectionId='6' Grid.Column="5"                          VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="150" Height="150">
                    <Ellipse Width="150" Height="150" StrokeThickness="12" Stroke="{StaticResource RaisedBrush}" />
                    <Ellipse x:ConnectionId='22' x:Name="RingFill" Width="150" Height="150" StrokeThickness="12" Stroke="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:ConnectionId='23' x:Name="RingPercent" Text="0%" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:ConnectionId='24' x:Name="RingLabel" Text="detenida" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='18' x:Name="StateText" Text="Vigilancia detenida" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:ConnectionId='19' x:Name="CurrentText" Text="Activa la vigilancia para empezar" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:ConnectionId='20' x:Name="QueueText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:ConnectionId='21' x:Name="PathText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Vigilancia de Descargas" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                    <ToggleSwitch x:ConnectionId='17' x:Name="WatchSwitch" OnContent="Activa" OffContent="Detenida"                         />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="ANALIZADOS" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='16' x:Name="KAnalyzed" Text="0" FontSize="28" FontWeight="Light" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OkBrush}" />
                        <TextBlock Text="LIMPIOS" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='15' x:Name="KClean" Text="0" FontSize="28" FontWeight="Light" Foreground="{StaticResource OkBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="SOSPECHOSOS" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='14' x:Name="KSus" Text="0" FontSize="28" FontWeight="Light" Foreground="{StaticResource WarnBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="MALICIOSOS" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='13' x:Name="KMal" Text="0" FontSize="28" FontWeight="Light" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,10" ColumnSpacing="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ARCHIVO" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="2" Text="VEREDICTO" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="3" Text="RIESGO" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="4" Text="TAMAÑO" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="5" Text="HORA" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <ListView x:ConnectionId='12' x:Name="ResultList" Grid.Row="1"                               
                          ItemTemplate="{StaticResource ResultRow}"
                          ItemContainerStyle="{StaticResource PlainListItem}"
                          SelectionMode="Single"                                            Padding="0" />
            </Grid>
        </Border>
    </Grid>
</Page>

