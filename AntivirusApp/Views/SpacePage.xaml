<Page
    x:Class="AntivirusApp.Views.SpacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled">

        <StackPanel x:Name="PageRoot" Spacing="12" Padding="0,0,10,0">

            <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="22,18" Background="{StaticResource HeroGradient}">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource RaisedBrush}">
                                <FontIcon Glyph="&#xE7B8;" FontSize="17" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="Aegiss_TheClurer" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Peso de las aplicaciones del sistema en mapa de cuadrados y compresión de carpetas a ZIP."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="HeadDetail"
                                   Text="Elige abajo: medir aplicaciones o comprimir carpetas."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12" Height="96">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="KpiApps" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,1,1,1" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="APLICACIONES" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KApps" Text="0" FontSize="24" FontWeight="Light" />
                        <TextBlock Text="medidas" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="KpiAppsSize" BorderBrush="{StaticResource VioletBrush}" BorderThickness="4,1,1,1" Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" Background="{StaticResource VioletBrush}" />
                        <TextBlock Text="PESO DE APPS" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KAppsSize" Text="0 B" FontSize="24" FontWeight="Light" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="en total" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="KpiFolders" BorderBrush="{StaticResource OkBrush}" BorderThickness="4,1,1,1" Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" Background="{StaticResource OkBrush}" />
                        <TextBlock Text="CARPETAS" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KFolders" Text="0" FontSize="24" FontWeight="Light" />
                        <TextBlock Text="para comprimir" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="KpiFoldersSize" BorderBrush="{StaticResource WarnBrush}" BorderThickness="4,1,1,1" Grid.Column="3" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" Background="{StaticResource WarnBrush}" />
                        <TextBlock Text="PESO EN CARPETAS" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KFoldersSize" Text="0 B" FontSize="24" FontWeight="Light" Foreground="{StaticResource OkBrush}" />
                        <TextBlock Text="medido" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18,16" MinHeight="150">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                                <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="APLICACIONES DEL SISTEMA" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Mide cuánto pesa cada aplicación instalada y lo dibuja en cuadrados."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Button x:Name="MeasureButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                                <TextBlock Text="Medir aplicaciones" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" MinHeight="150">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <TextBlock Text="CARPETAS A ZIP" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="ZipRootText"
                                   Text="Carpeta sin elegir."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="PickZipFolderButton" Style="{StaticResource GhostButton}" Padding="12,8">
                                <TextBlock Text="Cambiar carpeta…" FontSize="12" />
                            </Button>
                            <Button x:Name="ScanFoldersButton" Style="{StaticResource PrimaryButton}">
                                <TextBlock Text="Analizar carpetas" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="APLICACIONES · CUÁNTO PESAN"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       CharacterSpacing="70" />
                            <TextBlock x:Name="AppDescText"
                                       Text="Cada cuadrado es una aplicación: más grande, más pesa. Los pequeños son apps ligeras."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="AppViewButton"
                                Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Padding="12,7"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="AppViewText" Text="Gráfica de barras animadas" FontSize="12" />
                        </Button>
                    </Grid>

                    <Canvas x:Name="TreemapHost" Height="300" />

                    <ScrollViewer x:Name="AppBarsScroll"
                                  Height="300"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="AppBarsHost" Spacing="0" />
                    </ScrollViewer>

                    <TextBlock x:Name="TreemapNote"
                               Text="Sin medir todavía."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,11" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="APLICACIONES, DE MAYOR A MENOR PESO"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   CharacterSpacing="70"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AppsCount" Grid.Column="1" Text="Sin datos" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ScrollViewer Height="200" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="AppHost" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="CARPETAS PESADAS · CUÁNTO PESAN"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       CharacterSpacing="70" />
                            <TextBlock x:Name="FolderDescText"
                                       Text="Cada cuadrado es una carpeta: más grande, más pesa. Estas son las candidatas a comprimir en ZIP."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="FolderViewButton"
                                Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Padding="12,7"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="FolderViewText" Text="Gráfica de barras animadas" FontSize="12" />
                        </Button>
                    </Grid>

                    <Canvas x:Name="FolderMapHost" Height="240" />

                    <ScrollViewer x:Name="FolderBarsScroll"
                                  Height="240"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FolderBarsHost" Spacing="0" />
                    </ScrollViewer>

                    <TextBlock x:Name="FolderMapNote"
                               Text="Sin analizar todavía."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,11" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CARPETAS PESADAS · COMPRIMIR A ZIP"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   CharacterSpacing="70"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="FoldersCount" Grid.Column="1" Text="Sin datos" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ScrollViewer Height="240" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FolderHost" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ResultHost" Spacing="6" />

        </StackPanel>
    </ScrollViewer>
</Page>
