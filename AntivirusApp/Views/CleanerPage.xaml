<Page
    x:Class="AntivirusApp.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled">

        <StackPanel x:Name="PageRoot" Spacing="12" Padding="0,0,10,0">

            <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="22,18" Background="{StaticResource HeroGradient}">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource RaisedBrush}">
                                <FontIcon Glyph="&#xE74D;" FontSize="17" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="Aegiss_Clenaer" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Busca lo que más pesa en todo el equipo y libéralo cuando ya no lo uses."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="HeadDetail"
                                   Text="Pulsa Escanear equipo completo o elige una carpeta concreta."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0" />
                    </StackPanel>

                    <Grid x:Name="HeroVisual" Width="126" Height="126" Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse x:Name="HeroHalo"
                                 Width="126" Height="126"
                                 Stroke="{StaticResource LineBrush}"
                                 StrokeThickness="1"
                                 Opacity="0.55" />

                        <Ellipse x:Name="HeroOrbit"
                                 Width="112" Height="112"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="2"
                                 StrokeDashArray="1.2,6"
                                 StrokeDashCap="Round"
                                 Opacity="0.85"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="HeroOrbitTransform" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse x:Name="HeroOrbitInner"
                                 Width="84" Height="84"
                                 Stroke="{StaticResource VioletBrush}"
                                 StrokeThickness="1.5"
                                 StrokeDashArray="0.6,4.5"
                                 StrokeDashCap="Round"
                                 Opacity="0.75"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="HeroInnerTransform" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Grid x:Name="HeroSatellite" Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="HeroSatelliteTransform" Angle="0" />
                            </Grid.RenderTransform>
                            <Ellipse Width="9" Height="9"
                                     Fill="{StaticResource OkBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top" />
                        </Grid>

                        <Border x:Name="HeroBadge"
                                Width="62" Height="62"
                                CornerRadius="19"
                                Background="{StaticResource BrandBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <FontIcon Glyph="&#xE74D;" FontSize="23" Foreground="#FFFFFFFF"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7" MinWidth="250">
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Padding="18,12" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon Glyph="&#xE721;" FontSize="15" />
                                <TextBlock Text="Escanear equipo completo" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="StopButton"
                                Style="{StaticResource DangerGhostButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsEnabled="False">
                            <TextBlock Text="Detener" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12" Height="96">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="KpiFiles" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,1,1,1" Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="DotFiles" Width="8" Height="8" Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="ARCHIVOS REVISADOS" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KFiles" Text="0" FontSize="26" FontWeight="Light" />
                        <TextBlock Text="leídos durante el escaneo" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="KpiDirs" BorderBrush="{StaticResource VioletBrush}" BorderThickness="4,1,1,1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="DotDirs" Width="8" Height="8" Background="{StaticResource VioletBrush}" />
                        <TextBlock Text="CARPETAS REVISADAS" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KDirs" Text="0" FontSize="26" FontWeight="Light" />
                        <TextBlock Text="carpetas recorridas" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="KpiBytes" BorderBrush="{StaticResource OkBrush}" BorderThickness="4,1,1,1" Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="DotBytes" Width="8" Height="8" Background="{StaticResource OkBrush}" />
                        <TextBlock Text="PESO ENCONTRADO" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                    </StackPanel>
                        <TextBlock x:Name="KBytes" Text="0 B" FontSize="26" FontWeight="Light" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="suma de todo lo medido" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="O ANALIZA UNA CARPETA CONCRETA" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                        <TextBlock x:Name="FolderPathText"
                                   Text="Ninguna carpeta elegida todavía."
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Se mide solo esa carpeta; el resto del equipo no se toca."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="PickFolderButton" Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="Elegir carpeta…" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ScanFolderButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                            <TextBlock Text="Analizar esta carpeta" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="QUÉ SE MIDE" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                        <TextBlock x:Name="FilterText"
                                   Text="Solo se miden los elementos grandes: archivos de 20 MB o más y carpetas de 60 MB o más."
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Todo lo que esté por debajo de ese mínimo NO se mide ni aparece en la lista, porque libera muy poco espacio. Si quieres verlo todo, activa Incluir pequeños."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch x:Name="SmallToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  OnContent="Incluir pequeños"
                                  OffContent="Solo grandes" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ChartTitle" Text="TOP DE LOS QUE MÁS PESAN" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                        <TextBlock Text="La barra se compara siempre con el elemento más pesado de la lista." FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="BarsHost" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,11" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="TabFiles" Style="{StaticResource ChipButton}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                <TextBlock Text="Archivos" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TabFolders" Grid.Column="1" Style="{StaticResource ChipButton}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                <TextBlock Text="Carpetas" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ListHint"
                                   Grid.Column="2"
                                   Text="Sin resultados todavía."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,0,0" />

                        <TextBlock x:Name="CountText"
                                   Grid.Column="3"
                                   Text="Sin datos"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ProgressBar x:Name="SweepBar"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="0" />

                    <ScrollViewer Height="330"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RowHost" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
