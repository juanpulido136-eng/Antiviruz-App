<Page
    x:Class="AntivirusApp.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled">

        <StackPanel x:ConnectionId='2' x:Name="PageRoot" Spacing="12" Padding="0,0,10,0">

            <Border Style="{StaticResource Card}" Padding="24" Background="{StaticResource HeroGradientWarm}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Ellipse Width="104" Height="104" Stroke="{StaticResource BrandBrush}" StrokeThickness="3" />
                        <PersonPicture x:ConnectionId='14' x:Name="Avatar"
                                       Width="88"
                                       Height="88"
                                       Background="{StaticResource BrandBrush}"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='10' x:Name="HeaderName" Text="Cuenta" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:ConnectionId='11' x:Name="HeaderDesc"
                                   Text="Sin descripción todavía."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:ConnectionId='12' x:Name="PickPhotoButton" Style="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE91B;" FontSize="13" />
                                    <TextBlock Text="Cambiar foto…" />
                                </StackPanel>
                            </Button>

                            <Button x:ConnectionId='13' x:Name="ClearPhotoButton" Style="{StaticResource DangerGhostButton}">
                                <TextBlock Text="Quitar foto" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="DATOS DE LA CUENTA" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />

                    <TextBox x:ConnectionId='6' x:Name="NameBox"
                             Header="Nombre para mostrar"
                             PlaceholderText="Cómo quieres aparecer"
                             MaxLength="40" />

                    <TextBox x:ConnectionId='7' x:Name="DescBox"
                             Header="Descripción"
                             PlaceholderText="Qué hace esta cuenta, equipo, notas…"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="240"
                             Height="96" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:ConnectionId='8' x:Name="SaveButton" Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                <TextBlock Text="Guardar cambios" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:ConnectionId='9' x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="SESIÓN" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />

                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Usuario" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock x:ConnectionId='3' x:Name="SessionUser" Grid.Column="1" FontSize="12" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="1" Text="Perfil" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock x:ConnectionId='4' x:Name="SessionProfile" Grid.Row="1" Grid.Column="1" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Text="Foto" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock x:ConnectionId='5' x:Name="SessionPhoto" Grid.Row="2" Grid.Column="1" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="Las credenciales de acceso se validan dentro del código del programa y no se muestran en la interfaz. El perfil se guarda solo en este equipo."
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

