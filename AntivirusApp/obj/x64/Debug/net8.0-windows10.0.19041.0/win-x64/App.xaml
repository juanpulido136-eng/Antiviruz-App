<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AntivirusApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BgBrush" Color="#FFE9EFEC" />
            <SolidColorBrush x:Key="SideBrush" Color="#FFFBFDFC" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FFE6EDEA" />
            <SolidColorBrush x:Key="LineBrush" Color="#FFCBD6D2" />
            <SolidColorBrush x:Key="TextBrush" Color="#FF14191A" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF2E3A38" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0B6B68" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE3F0EF" />
            <SolidColorBrush x:Key="VioletBrush" Color="#FF6D5BD0" />
            <SolidColorBrush x:Key="OkBrush" Color="#FF15966B" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFD98A00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFE5484D" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC0353A" />
            <SolidColorBrush x:Key="DangerSolidBrush" Color="#FFE5484D" />

            <LinearGradientBrush x:Key="ContentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF1F6F4" Offset="0" />
                <GradientStop Color="#FFFBF9FF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE7F2F0" Offset="0" />
                <GradientStop Color="#FFF7F5FF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradientWarm" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFDF3E7" Offset="0" />
                <GradientStop Color="#FFF3F0FF" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0B6B68" Offset="0" />
                <GradientStop Color="#FF6D5BD0" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="15,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="DangerGhostButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="DangerSolidButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DangerSolidBrush}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="PlainListItem" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

