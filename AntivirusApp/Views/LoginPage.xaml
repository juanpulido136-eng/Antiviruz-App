<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntivirusApp.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <Grid x:Name="PageRoot">

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    Margin="26,22,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <Grid x:Name="LogoBox" Width="38" Height="38">
                <Border CornerRadius="12" Background="{StaticResource BrandBrush}" />
                <Border CornerRadius="12" BorderBrush="#59FFFFFF" BorderThickness="1" Margin="1" />
                <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="#FFFFFFFF"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Aegis" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Endpoint Suite · v22.0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Acceso local · v22.0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,26,26,0"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}" />

        <Border Width="440"
                Padding="30,26"
                CornerRadius="10"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">

                <StackPanel Spacing="6">
                    <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Accede al panel de protección del equipo."
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,2" />

                <TextBox x:Name="UserBox"
                         Header="Usuario"
                         PlaceholderText="Escribe tu usuario"
                         FontSize="14" />

                <PasswordBox x:Name="PassBox"
                             Header="Contraseña"
                             PlaceholderText="Escribe tu contraseña"
                             PasswordRevealMode="Hidden"
                             FontSize="14" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource DangerTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Button x:Name="EnterButton"
                        Content="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" />

                <TextBlock Text="La validación se hace en este equipo y las credenciales no se muestran en la interfaz."
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

            </StackPanel>
        </Border>

        <TextBlock x:Name="VersionText"
                   Text="v22.0 · Aegiss_Clenaer · Aegiss_TheClurer · Cuenta"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,18"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Page>
