<Page
    x:Class="AntivirusApp.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SideBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Grid x:Name="LogoBox" Width="32" Height="32" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="{StaticResource BrandBrush}" />
                        <Border CornerRadius="10" BorderBrush="#59FFFFFF" BorderThickness="1" Margin="1" />
                        <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#FFFFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Aegis" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Endpoint Suite" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Width="10" Height="10" Background="{StaticResource OkBrush}" />
                    <TextBlock Text="Protección activa" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="HelpButton"
                            Style="{StaticResource GhostButton}"
                            Padding="9,7"
                            ToolTipService.ToolTip="Ayuda: qué hace cada módulo">
                        <FontIcon Glyph="&#xE897;" FontSize="13" />
                    </Button>

                    <TextBlock x:Name="HeaderUserName"
                               Text="admin"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />

                    <Grid x:Name="AvatarRing" Width="40" Height="40" VerticalAlignment="Center">
                        <Ellipse Stroke="{StaticResource BrandBrush}" StrokeThickness="2.5" />
                        <PersonPicture x:Name="HeaderAvatar"
                                       Width="32"
                                       Height="32"
                                       Initials="AE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SideBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="MÓDULOS"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               CharacterSpacing="110"
                               Margin="22,0,0,10" />

                    <StackPanel Grid.Row="1" Spacing="2">
                        <Button x:Name="NavScan" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="01" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Análisis manual" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Archivos, carpetas y ZIP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="NavCleaner" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="02" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Aegiss_Clenaer" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Lo que más pesa en el equipo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="NavSpace" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="03" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Aegiss_TheClurer" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Apps en cuadrados y ZIP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="NavLive" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="04" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Vigilancia en vivo" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Descargas en tiempo real" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="22,10" />

                        <Button x:Name="NavHelp" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="06" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Ayuda" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Qué hace cada módulo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="NavAccount" Style="{StaticResource NavButton}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="05" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Cuenta" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Foto, nombre y descripción" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3" Margin="14,0" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource OkBrush}" />
                                <TextBlock Text="BETA AEGIS V22.0" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Motor Heurotastic Lyon · v22.0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="26,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="Ficha de equipo · v22.0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <Border Grid.Row="1" Padding="26,20" Background="{StaticResource ContentGradient}">
                    <Frame x:Name="ContentFrame" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SideBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,0">
            <Grid>
                <TextBlock Text="Aegis · Endpoint Suite · v22.0 · demo local"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="v22.0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <Border x:Name="Scrim" Grid.RowSpan="3" Background="#3314191A" Visibility="Collapsed" Tapped="Scrim_Tapped" />

        <Border x:Name="Drawer"
                Grid.RowSpan="3"
                HorizontalAlignment="Right"
                Width="440"
                Background="{StaticResource SideBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="24,20" ColumnSpacing="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DrawerIconBox" Width="40" Height="40" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                        <FontIcon x:Name="DrawerGlyph" FontSize="17" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DrawerState" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="DrawerName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10" Click="CloseDetail_Click">
                        <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="14" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Origen" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="DrOrigin" Grid.Column="1" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                            <TextBlock Grid.Row="1" Text="Tipo" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="DrType" Grid.Row="1" Grid.Column="1" FontSize="12" />

                            <TextBlock Grid.Row="2" Text="Tamaño" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="DrSize" Grid.Row="2" Grid.Column="1" FontSize="12" />

                            <TextBlock Grid.Row="3" Text="Analizado" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="DrTime" Grid.Row="3" Grid.Column="1" FontSize="12" />

                            <TextBlock Grid.Row="4" Text="SHA256" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="DrSha" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MOTIVOS DEL VEREDICTO" FontSize="10" Foreground="{StaticResource MutedBrush}" CharacterSpacing="70" />
                            <ItemsControl x:Name="ReasonsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" IsTextSelectionEnabled="True" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ShowButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ShowFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <TextBlock Text="Mostrar carpeta" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Grid.Column="1" Style="{StaticResource DangerSolidButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Eliminar" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Page>
